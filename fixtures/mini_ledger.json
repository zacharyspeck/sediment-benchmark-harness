  "house_rules": [
    {
      "id": "HR-01",
      "firm": "halloran",
      "added_date": "2015-01-05",
      "rule": "Executive summary section order: company statement, business and moat, customer stickiness, financial highlights."
    },
    {
      "id": "HR-02",
      "firm": "halloran",
      "added_date": "2015-01-05",
      "rule": "Never present management projections in an executive summary. Actuals only."
    },
    {
      "id": "HR-03",
      "firm": "halloran",
      "added_date": "2015-01-05",
      "rule": "Plain English. If a phrase would embarrass you read aloud to the founder, cut it."
    },
    {
      "id": "HR-04",
      "firm": "halloran",
      "added_date": "2015-01-05",
      "rule": "No stacked superlatives. One strong claim beats three inflated ones."
    },
    {
      "id": "HR-05",
      "firm": "halloran",
      "added_date": "2016-03-14",
      "rule": "Numbers in $M with one decimal. Margins to one decimal."
    },
